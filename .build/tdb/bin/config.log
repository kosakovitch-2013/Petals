                    }
                    if (fd2 == -1) exit(1);
                    unlink(tpl);
                    unlink(tpl2);
                    if (fstat(fd, &st) != 0) exit(1);
                    if ((st.st_mode & 0777) != 0600) exit(1);
                    if (strcmp(tpl, "/tmp/test.XXXXXX") == 0) {
                          exit(1);
                    }
                    if (strcmp(tpl, tpl2) == 0) {
                          exit(1);
                    }
                    exit(0);
