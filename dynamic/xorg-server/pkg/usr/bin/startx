#!/bin/sh

# Find mouse
for dev in /dev/input/event*; do
    name=$(cat /sys/class/input/$(basename $dev)/device/name 2>/dev/null)
    case "$name" in *[Mm]ouse*|*[Tt]ablet*) MOUSE=$dev; break ;; esac
done
[ -z "$MOUSE" ] && MOUSE="/dev/input/event3"

# Find keyboard
for dev in /dev/input/event*; do
    name=$(cat /sys/class/input/$(basename $dev)/device/name 2>/dev/null)
    case "$name" in *[Kk]eyboard*|*[Aa][Tt]\ *) KBD=$dev; break ;; esac
done
[ -z "$KBD" ] && KBD="/dev/input/event2" 

mkdir -p /etc/X11
cat > /etc/X11/xorg.conf << XCONF
# this is auto generated by startx

Section "ServerLayout"
    Identifier "layout"
    Screen "screen"
    InputDevice "keyboard" "CoreKeyboard"
    InputDevice "mouse" "CorePointer"
EndSection
Section "InputDevice"
    Identifier "keyboard"
    Driver "evdev"
    Option "Device" "$KBD"
EndSection
Section "InputDevice"
    Identifier "mouse"
    Driver "evdev"
    Option "Device" "$MOUSE"
EndSection
Section "Screen"
    Identifier "screen"
    Device "GPU"
EndSection
Section "Device"
    Identifier "GPU"
    Driver "modesetting"
EndSection
XCONF

xinit &
