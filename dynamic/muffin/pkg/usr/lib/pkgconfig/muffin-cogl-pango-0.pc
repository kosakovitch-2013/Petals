prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

apiversion=0

Name: CoglPango
Description: A text rendering for Cogl in mutter
Version: 5.4.4
Requires: glib-2.0 >=  2.61.1, gobject-2.0 >=  2.61.1, graphene-gobject-1.0 >=  1.9.3, egl, x11, gl, glesv2, muffin-cogl-0
Libs: -L${prefix}/lib/muffin -lmuffin-cogl-pango-0
Cflags: -I${includedir}/muffin/cogl
