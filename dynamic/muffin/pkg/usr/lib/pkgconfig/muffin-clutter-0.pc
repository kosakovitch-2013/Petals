prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

apiversion=0

Name: Muffins Clutter
Description: Muffinss Clutter Private Library
Version: 5.4.4
Requires: atk >=  2.5.3, cairo-gobject >=  1.10.0, glib-2.0 >=  2.61.1, gobject-2.0 >=  2.61.1, gio-unix-2.0 >=  2.61.1, json-glib-1.0 >=  0.12.0, pango >=  1.2.0, x11, muffin-cogl-0
Libs: -L${prefix}/lib/muffin -lmuffin-clutter-0 -lm
Cflags: -I${includedir}/muffin/clutter
