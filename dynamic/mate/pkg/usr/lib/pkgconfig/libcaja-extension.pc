prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
extensiondir=${exec_prefix}/lib/caja/extensions-2.0

Name: libcaja-extension
Description: A library to create Caja view extensions
Version: 1.28.0
Requires: glib-2.0 gio-2.0 gtk+-3.0
Libs: -L${libdir} -lcaja-extension
Cflags: -I${includedir}/caja
