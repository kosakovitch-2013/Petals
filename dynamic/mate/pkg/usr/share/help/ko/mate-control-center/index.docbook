       Use the app entity to specify the name of the application. -->]>
<article id="index" lang="ko">
  
  <articleinfo>
    <abstract role="description">
      <para lang="en">
        The MATE Control Center provides a central place for the user to setup their MATE experience. It can let you configure anything from the behavior of your window borders to the default font type.
      </para>
    </abstract>
    <title lang="en">MATE Control Center Manual</title>
    <authorgroup>
      <author><firstname>MATE 문서화 프로젝트</firstname> <surname/> <affiliation> <orgname>MATE 데스크톱</orgname> </affiliation></author>
      <author lang="en">
	<firstname>Kevin</firstname><surname>Breit</surname>
      </author>
    </authorgroup>
    <copyright><year>2015-2021</year> <holder>MATE 문서화 프로젝트</holder></copyright>
    <copyright lang="en">
      <year>2001, 2002</year>
      <holder>Ximian, Inc.</holder>
    </copyright>

    <publisher role="maintainer">
      <publishername>MATE 문서화 프로젝트</publishername>
    </publisher>
    <publisher>
      <publishername>GNOME 문서화 프로젝트</publishername>
    </publisher>
    
    <revhistory>
      <revision><revnumber>2.15</revnumber> <date>July 2015</date> <firstname>MATE 문서화 프로젝트</firstname> <surname/></revision>
